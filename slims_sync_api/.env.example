# Salin file ini menjadi .env di Komputer B (server database MySQL SLiMS)
# dan isi sesuai kondisi sebenarnya. JANGAN commit file .env ke git.

# --- Koneksi MySQL SLiMS (WAJIB localhost - jangan buka port MySQL ke LAN) ---
SLIMS_DB_HOST=localhost
SLIMS_DB_PORT=3306
SLIMS_DB_NAME=senayan
# Gunakan user MySQL read-only, bukan root. Contoh membuatnya:
#   CREATE USER 'libnis_ro'@'localhost' IDENTIFIED BY 'ganti-password-ini';
#   GRANT SELECT ON senayan.* TO 'libnis_ro'@'localhost';
#   FLUSH PRIVILEGES;
SLIMS_DB_USER=libnis_ro
SLIMS_DB_PASSWORD=

# --- Auth API ini sendiri ---
# Buat string acak panjang, mis: python -c "import secrets; print(secrets.token_hex(32))"
SYNC_API_KEY=

# --- Port service (harus di-whitelist firewall hanya untuk IP komputer Libnis) ---
SYNC_API_PORT=8000

# --- Jumlah baris maksimum per response /api/sync ---
SYNC_PAGE_SIZE=2000

# --- Nama kolom timestamp per tabel - TODO: VERIFIKASI terhadap skema SLiMS ---
# yang sebenarnya (cek lewat phpMyAdmin/mysql client di Komputer B), nilai di
# bawah ini hanya asumsi default berdasarkan skema SLiMS pada umumnya.
SLIMS_COL_BIBLIO_TS=last_update
SLIMS_COL_ITEM_TS=last_update
SLIMS_COL_MEMBER_TS=input_date
SLIMS_COL_LOAN_TS=loan_date
